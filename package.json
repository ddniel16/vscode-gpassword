{
  "activationEvents": [],
  "author": {
    "name": "ddniel16",
    "url": "https://github.com/ddniel16"
  },
  "bugs": {
    "url": "https://github.com/ddniel16/vscode-gpassword/issues"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "category": "gPassword",
        "command": "gpassword.Letters",
        "title": "Letters only"
      },
      {
        "category": "gPassword",
        "command": "gpassword.LettersNumbers",
        "title": "Letters and numbers"
      },
      {
        "category": "gPassword",
        "command": "gpassword.AllCharacters",
        "title": "Letters, Numbers & Symbols"
      },
      {
        "category": "gPassword",
        "command": "gpassword.passwordToBasicAuth",
        "title": "Replace password to hash of Basic Auth (bcrypt.hashSync)"
      },
      {
        "category": "gPassword",
        "command": "gpassword.BaseEncode",
        "title": "Base64 Encode"
      },
      {
        "category": "gPassword",
        "command": "gpassword.BaseDecode",
        "title": "Base64 Decode"
      },
      {
        "category": "gPassword",
        "command": "gpassword.WordPressSaltYml",
        "title": "WordPress Salt YML"
      },
      {
        "category": "gPassword",
        "command": "gpassword.WordPressSaltEnv",
        "title": "WordPress Salt ENV"
      },
      {
        "category": "gPassword",
        "command": "gpassword.StrapiYml",
        "title": "Strapi Tokens YML"
      },
      {
        "category": "gPassword",
        "command": "gpassword.StrapiEnv",
        "title": "Strapi Tokens ENV"
      },
      {
        "category": "gPassword",
        "command": "gpassword.JWT",
        "title": "JWT Decode"
      },
      {
        "category": "gPassword",
        "command": "gpassword.UrlEncode",
        "title": "URL Encode"
      },
      {
        "category": "gPassword",
        "command": "gpassword.UrlDecode",
        "title": "URL Decode"
      },
      {
        "category": "gPassword",
        "command": "gpassword.switchTool",
        "title": "Switch Tool"
      }
    ],
    "configuration": [
      {
        "order": 1,
        "properties": {
          "gpassword.randomLengthMax": {
            "default": 25,
            "description": "Maximum characters for random password (Command & Submenu)",
            "maximum": 55,
            "minimum": 16,
            "type": "integer"
          },
          "gpassword.randomLengthMin": {
            "default": 20,
            "description": "Minimum characters for random password (Command & Submenu)",
            "maximum": 54,
            "minimum": 15,
            "type": "integer"
          }
        },
        "title": "gPassword: General"
      },
      {
        "order": 2,
        "properties": {
          "gpassword.defaultTool": {
            "default": "base64",
            "description": "Default tool to show in the sidebar when opening the extension",
            "enum": [
              "password",
              "jwt",
              "base64",
              "salts",
              "url"
            ],
            "enumItemLabels": [
              "Password Generator",
              "JWT Decoder & Validator",
              "Base64 Encoder/Decoder",
              "Salts Generator",
              "URL Encoder/Decoder"
            ],
            "type": "string"
          }
        },
        "title": "gPassword: Sidebar"
      },
      {
        "order": 3,
        "properties": {
          "gpassword.passwordGeneratorDefault.includeNumbers": {
            "default": true,
            "description": "Include numbers in password",
            "type": "boolean"
          },
          "gpassword.passwordGeneratorDefault.includeSymbols": {
            "default": true,
            "description": "Include symbols in password",
            "type": "boolean"
          },
          "gpassword.passwordGeneratorDefault.includeUppercase": {
            "default": true,
            "description": "Include uppercase letters in password",
            "type": "boolean"
          },
          "gpassword.passwordGeneratorLength": {
            "default": 20,
            "description": "Default length for password generator",
            "maximum": 55,
            "minimum": 10,
            "type": "integer"
          }
        },
        "title": "gPassword: Password Generator (Sidebar)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "group": "gpassword",
          "submenu": "gpassword.submenu",
          "when": "editorTextFocus && !editorReadonly"
        }
      ],
      "gpassword.submenu": [
        {
          "command": "gpassword.BaseDecode",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.BaseEncode",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.passwordToBasicAuth",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.JWT",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.UrlEncode",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.UrlDecode",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && editorHasSelection"
        },
        {
          "command": "gpassword.AllCharacters",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.LettersNumbers",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.Letters",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.WordPressSaltYml",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.WordPressSaltEnv",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.StrapiYml",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        },
        {
          "command": "gpassword.StrapiEnv",
          "group": "gpassword",
          "when": "editorTextFocus && !editorReadonly && !editorHasSelection"
        }
      ]
    },
    "submenus": [
      {
        "id": "gpassword.submenu",
        "label": "gPassword"
      }
    ],
    "views": {
      "passwordGenerator": [
        {
          "id": "passwordGenerator.navigator",
          "name": "Tools selector"
        },
        {
          "id": "passwordGenerator.toolView",
          "name": "Tool view",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "icon": "media/lock.svg",
          "id": "passwordGenerator",
          "title": "gPassword & Encoder Tools"
        }
      ]
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "description": "Generator password & Encoder Tools is a one-stop solution for strong password generation and encoding tools.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "displayName": "Generator password & Encoder Tools",
  "engines": {
    "vscode": "^1.120.0"
  },
  "galleryBanner": {
    "color": "#0C4A6E",
    "theme": "dark"
  },
  "homepage": "https://github.com/ddniel16/vscode-gpassword#readme",
  "icon": "imgs/icon.png",
  "keywords": [
    "security",
    "password",
    "bcrypt",
    "base64",
    "basic auth",
    "jwt decode",
    "WordPress Salt",
    "url encode/decode"
  ],
  "license": "GPL-3.0-or-later",
  "main": "./out/extension.js",
  "name": "gpassword",
  "packageManager": "pnpm@11.4.0",
  "pricing": "Free",
  "publisher": "ddniel16",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddniel16/vscode-gpassword"
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "compile:types": "tsc -p ./ --noEmit",
    "format": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.mjs\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "postversion": "git push && git push --tags",
    "pretest": "node --run lint && node --run format && node --run compile:types",
    "test": "vscode-test",
    "vscode:prepublish": "node --run compile",
    "watch": "node esbuild.mjs --watch"
  },
  "version": "0.2.2"
}
